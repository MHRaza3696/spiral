// Carousel
(function(){
  const root = document.getElementById('academyCarousel');
  const slides = [...root.querySelectorAll('.carousel-slide')];
  const dotWrap = root.querySelector('.carousel-dots');
  let i = 0, timer;
  slides.forEach((_, n) => {
    const b = document.createElement('button');
    b.className = 'carousel-dot' + (n === 0 ? ' active' : '');
    b.setAttribute('aria-label', 'Go to image ' + (n + 1));
    b.addEventListener('click', () => { go(n); reset(); });
    dotWrap.appendChild(b);
  });
  const dots = [...dotWrap.children];
  function go(n){
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => s.classList.toggle('active', k === i));
    dots.forEach((d, k) => d.classList.toggle('active', k === i));
  }
  function reset(){ clearInterval(timer); timer = setInterval(() => go(i + 1), 5500); }
  root.querySelector('.prev').addEventListener('click', () => { go(i - 1); reset(); });
  root.querySelector('.next').addEventListener('click', () => { go(i + 1); reset(); });
  reset();
})();
</script>
