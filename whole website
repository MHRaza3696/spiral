<script>
document.querySelectorAll('.mobile-menu a').forEach(a => a.addEventListener('click', () => {
  document.getElementById('mobile-menu').classList.remove('open');
}));
if(new URLSearchParams(location.search).get('sent')==='1'){
  document.getElementById('academy-form').style.display='none';
  document.getElementById('academy-payment').style.display='none';
  document.getElementById('academy-success').style.display='block';
}
// Two-step registration: details -> payment
(function(){
  const form = document.getElementById('academy-form');
  const pay = document.getElementById('academy-payment');
  if(!form || !pay) return;
  form.addEventListener('submit', e => {
    e.preventDefault();
    if(!form.reportValidity()) return;
    document.getElementById('sum-name').textContent = form.name.value || '—';
    document.getElementById('sum-course').textContent = form.course.value || 'To be advised';
    form.style.display = 'none';
    pay.style.display = 'block';
    window.scrollTo({ top: pay.getBoundingClientRect().top + window.pageYOffset - 100, behavior: 'smooth' });
  });
  document.getElementById('pay-back').addEventListener('click', () => {
    pay.style.display = 'none';
    form.style.display = '';
    window.scrollTo({ top: form.getBoundingClientRect().top + window.pageYOffset - 100, behavior: 'smooth' });
  });
  document.getElementById('pay-confirm').addEventListener('click', () => {
    const picked = pay.querySelector('input[name="paymethod"]:checked');
    document.getElementById('ac-payment-method').value = picked ? picked.value : '';
    form.submit();
  });
})();
</script>
